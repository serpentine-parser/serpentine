# Storage
SERPENTINE_STORE_BACKEND=local
SERPENTINE_LOCAL_STORE_PATH=/absolute/path/to/store   # no default; must set

# Repos (local dev)
SERPENTINE_REPOS_DIR=/absolute/path/to/repos          # dir of local git checkouts

# Auth (disable for local testing only)
SERPENTINE_MCP_ALLOW_UNAUTHENTICATED=true

# GitHub (Phase 3+)
# SERPENTINE_GITHUB_TOKEN=ghp_xxx
# SERPENTINE_ALLOWED_REPOS=org/repo1,org/repo2
