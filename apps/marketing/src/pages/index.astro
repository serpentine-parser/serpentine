</style>

<script>
(function () {
  type HarnessKey = 'claude' | 'cursor' | 'copilot' | 'codex' | 'opencode';
  const HARNESS: Record<HarnessKey, { cmd: string; note: string }> = {
    claude: {
      cmd: 'serpentine init',
      note: 'Installs <code>.claude/skills/code-analysis/</code> and appends to <code>CLAUDE.md</code>. Detected automatically if <code>.claude/</code> is present.',
    },
    cursor: {
      cmd: 'serpentine init --harness cursor',
      note: 'Installs <code>.cursor/rules/serpentine.mdc</code>. Detected automatically if <code>.cursor/</code> is present.',
    },
    copilot: {
      cmd: 'serpentine init --harness copilot',
      note: 'Appends a Serpentine section to <code>.github/copilot-instructions.md</code>.',
    },
    codex: {
      cmd: 'serpentine init --harness codex',
      note: 'Appends a Serpentine section to <code>AGENTS.md</code>.',
    },
    opencode: {
      cmd: 'serpentine init --harness opencode',
      note: 'Appends a Serpentine section to <code>AGENTS.md</code>. Detected automatically if <code>.opencode/</code> is present.',
    },
  };

  const tabs = document.querySelectorAll<HTMLElement>('.agent-tab');
  const cmdEl = document.getElementById('harness-cmd');
  const noteEl = document.getElementById('harness-note');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      const key = tab.dataset.harness as HarnessKey;
      const h = HARNESS[key];
      if (cmdEl) cmdEl.innerHTML = `<span class="prompt">$</span><span>${h.cmd}</span>`;
      if (noteEl) noteEl.innerHTML = h.note;
    });
  });
})();

(function () {
  const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement;
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  if (!ctx) return;

  type Line = {
    y0f: number; cp1xf: number; cp1yf: number;
    cp2xf: number; cp2yf: number; y1f: number;
    alpha: number; width: number; color: string;
  };

  // CP1 at x=0.44 keeps lines lazy/flat near their start.
  // CP2 at x=0.74 snaps them to their final position in the right third,
  // creating a crossing cluster similar to the reference.
  // cp1yf === y0f and cp2yf === y1f gives flat horizontal tangents at both ends.
  // cp1xf/cp2xf near 0.5 concentrates the bend in the center, like pulling a midpoint handle in Illustrator.
  const LINES: Line[] = [
    { y0f:0.08, cp1xf:0.42, cp1yf:0.08, cp2xf:0.58, cp2yf:0.62, y1f:0.62, alpha:0.28, width:2.5, color:'#34d399' },
    { y0f:0.14, cp1xf:0.45, cp1yf:0.14, cp2xf:0.55, cp2yf:0.46, y1f:0.46, alpha:0.14, width:0.5, color:'#c4ff5e' },
    { y0f:0.20, cp1xf:0.40, cp1yf:0.20, cp2xf:0.60, cp2yf:0.10, y1f:0.10, alpha:0.22, width:1.8, color:'#20fb98' },
    { y0f:0.26, cp1xf:0.46, cp1yf:0.26, cp2xf:0.54, cp2yf:0.05, y1f:0.05, alpha:0.13, width:0.4, color:'#818cf8' },
    { y0f:0.30, cp1xf:0.42, cp1yf:0.30, cp2xf:0.58, cp2yf:0.55, y1f:0.55, alpha:0.25, width:3.0, color:'#34d399' },
    { y0f:0.34, cp1xf:0.44, cp1yf:0.34, cp2xf:0.56, cp2yf:0.22, y1f:0.22, alpha:0.16, width:0.9, color:'#22d3ee' },
    { y0f:0.38, cp1xf:0.41, cp1yf:0.38, cp2xf:0.59, cp2yf:0.68, y1f:0.68, alpha:0.10, width:1.3, color:'#a3e635' },
  ];

  let animating = true;

  function draw(now = 0) {
    if (!animating) return;
    const W = canvas.width;
    const H = canvas.height;
    ctx.clearRect(0, 0, W, H);

    for (let i = 0; i < LINES.length; i++) {
      const l = LINES[i];
      const phase = i * 1.1;
      const speed = 0.00035 + i * 0.00004;
      const amp   = 0.05;
      const cp1y  = l.cp1yf + Math.sin(now * speed + phase) * amp;
      const cp2y  = l.cp2yf + Math.sin(now * speed + phase + 0.8) * amp;

      ctx.beginPath();
      ctx.moveTo(-2, H * l.y0f);
      ctx.bezierCurveTo(
        W * l.cp1xf, H * cp1y,
        W * l.cp2xf, H * cp2y,
        W + 2,       H * l.y1f,
      );
      ctx.strokeStyle = l.color;
      ctx.lineWidth   = l.width;
      ctx.globalAlpha = l.alpha;
      ctx.lineCap     = 'round';
      ctx.stroke();
    }
    ctx.globalAlpha = 1;

    requestAnimationFrame(draw as FrameRequestCallback);
  }

  function resize() {
    const rect = canvas.parentElement!.getBoundingClientRect();
    canvas.width  = rect.width;
    canvas.height = rect.height;
  }

  resize();
  new ResizeObserver(resize).observe(canvas.parentElement!);

  new IntersectionObserver(entries => {
    const visible = entries[0].isIntersecting;
    if (visible && !animating) { animating = true; draw(); }
    else if (!visible) { animating = false; }
  }, { threshold: 0 }).observe(canvas);

  draw();
})();
</script>
