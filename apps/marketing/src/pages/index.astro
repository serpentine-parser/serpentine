---
import Base from '../layouts/Base.astro';

const GITHUB = 'https://github.com/serpentine-parser/serpentine';
---

<Base title="Serpentine — Richer context. Less noise. Fewer surprises.">

  <!-- HERO -->
  <section class="hero">
    <div class="hero-bg"></div>
    <canvas id="hero-canvas" aria-hidden="true"></canvas>
    <div class="hero-grid"></div>

    <div class="hero-glass">
    <div class="hero-badge">
      <span class="dot"></span>
      v0.2.0 · Apache 2.0
    </div>

    <h1>
      <em>Richer context.</em><br />
      Less noise.<br />
      Fewer surprises.
    </h1>

    <p class="hero-sub">
      Your agent's first move is usually the most expensive:
      building context through <code>grep</code>, <code>find</code>, and reading files.
      <span style="color: #34d399; font-weight: bold">Serpentine</span> gives it a structural picture of your codebase —
      every reference between every definition — before it reads a single file.
    </p>

    <div
      class="hero-install"
      onclick="navigator.clipboard?.writeText('pip install serpentine-parser')"
    >
      <span class="prompt">$</span>
      <span>pip install serpentine-parser</span>
      <span class="copy-hint">click to copy</span>
    </div>

    <p class="hero-sub"><span>then in your project</span></p>


    <!-- Harness switcher -->
    <div class="agent-switcher">
      <div class="agent-tabs">
        <button class="agent-tab active" data-harness="claude">
          <!-- Anthropic "A" mark -->
          <svg class="tab-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M8 2 2.5 14h3l1-2.5h3l1 2.5h3L8 2Zm0 3.5 1.1 3.5H6.9L8 5.5Z" fill="#d97706"/>
          </svg>
          Claude Code
        </button>
        <button class="agent-tab" data-harness="cursor">
          <!-- Cursor arrow mark -->
          <svg class="tab-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 2 13 8 8 9.5 6 15Z" fill="#818cf8"/>
          </svg>
          Cursor
        </button>
        <button class="agent-tab" data-harness="copilot">
          <!-- GitHub mark -->
          <svg class="tab-icon" viewBox="0 0 16 16" fill="#94a3b8" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>
          </svg>
          Copilot
        </button>
        <button class="agent-tab" data-harness="codex">
          <!-- OpenAI mark -->
          <svg class="tab-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M13.5 6.37A3.88 3.88 0 0 0 10.07 2a3.9 3.9 0 0 0-3.72 2.75A3.38 3.38 0 0 0 2.5 7.9a3.38 3.38 0 0 0 1.63 4.7A3.88 3.88 0 0 0 7.93 16a3.9 3.9 0 0 0 3.72-2.75A3.38 3.38 0 0 0 13.5 6.37ZM10.07 15a2.88 2.88 0 0 1-2.76-2.1l-.05-.18.17-.1 1.43-.82.15-.09.15.09 1.43.82-.05.18A2.88 2.88 0 0 1 10.07 15ZM3.5 11.25a2.38 2.38 0 0 1 0-2.5l.1-.17.17.1 1.43.82.15.09v1.64l-.15.09-1.43.82-.17.1ZM5.35 5.6l-.05-.18A2.88 2.88 0 0 1 7.93 3a2.9 2.9 0 0 1 2.76 2.1l.05.18-.17.1-1.43.82-.15.09H7.5l-.15-.09-1.43-.82Zm8.15 3.15-.1.17-.17-.1-1.43-.82-.15-.09V6.27l.15-.09 1.43-.82.17-.1.1.17a2.38 2.38 0 0 1 0 3.32Z" fill="#10a37f"/>
          </svg>
          Codex
        </button>
        <button class="agent-tab" data-harness="opencode">
          <!-- Terminal prompt -->
          <svg class="tab-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M2.5 5.5 6.5 8l-4 2.5" stroke="#64748b" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M8.5 10.5H13" stroke="#64748b" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          OpenCode
        </button>
      </div>
      <div class="agent-command">
        <div class="agent-command-body">
          <div class="line" id="harness-cmd">
            <span class="prompt">$</span>
            <span>serpentine init</span>
          </div>
        </div>
        <div class="agent-command-note" id="harness-note">
          Installs <code>.claude/skills/code-analysis/</code> and
          appends to <code>CLAUDE.md</code>. Detected automatically
          if <code>.claude/</code> is present.
        </div>
      </div>
    </div>

    <div class="hero-ctas">
      <a href="/docs/getting-started/installation" class="btn btn-primary">Get started →</a>
      <a href={GITHUB} class="btn btn-secondary" target="_blank" rel="noopener">View on GitHub</a>
    </div>
    </div>
  </section>

  <!-- PROBLEM -->
  <section class="problem">
    <p>
      Without structure, your agent reads until it
      <span class="highlight">thinks</span> it knows enough. It
      usually doesn't. Plans miss dependencies. Changes find new
      callsites halfway through. The session fills up, quality drops,
      and you're left fixing code that was already working.
    </p>
    <p>Avoid context rot, and get better results.</p>
  </section>

  <!-- HOW IT WORKS -->
  <section class="how">
    <div class="section-label">How it works</div>
    <h2 class="section-title">Orient first. Then build.</h2>
    <p class="section-sub">Three calls. That's the whole workflow.</p>

    <div class="steps">
      <div class="step">
        <div class="step-num">01</div>
        <div class="step-content">
          <h3>Get the lay of the land</h3>
          <div class="code-block">
            <span class="cmd-prompt">$</span>
            <span>serpentine stats .</span>
          </div>
          <p class="step-desc">
            Module names, node counts, rough scale. Your agent
            knows what it's dealing with before it opens a file.
          </p>
        </div>
      </div>

      <div class="step">
        <div class="step-num">02</div>
        <div class="step-content">
          <h3>Find what's relevant</h3>
          <div class="code-block">
            <span class="cmd-prompt">$</span>
            <span>serpentine catalog . <span class="cmd-flag">--filter</span> <span class="cmd-arg">"*auth*"</span></span>
          </div>
          <p class="step-desc">
            Every function, class, and variable whose name or
            location matches — flat, indexed, ready to query.
          </p>
        </div>
      </div>

      <div class="step">
        <div class="step-num">03</div>
        <div class="step-content">
          <h3>Get the exact subgraph</h3>
          <div class="code-block">
            <span class="cmd-prompt">$</span>
            <span>serpentine analyze . <span class="cmd-flag">--select</span> <span class="cmd-arg">"+src.auth.*+"</span></span>
          </div>
          <p class="step-desc">
            Everything that touches the area you care about:
            upstream, downstream, or both. No file reads required.
          </p>
        </div>
      </div>

      <div class="step-footer">
        Your agent reads the edges, then opens only the files that matter.
      </div>
    </div>
  </section>

  <!-- TRIO -->
  <section class="trio">
    <div class="section-label">Why it matters</div>
    <h2 class="section-title">
      What changes when your<br />agent knows the structure.
    </h2>

    <div class="trio-grid">
      <div class="trio-card">
        <span class="trio-icon">◈</span>
        <h3>Richer context</h3>
        <p>
          Structural orientation before the agent reads a single
          file. It knows what calls what, what inherits what, what
          breaks if you change something.
        </p>
      </div>
      <div class="trio-card">
        <span class="trio-icon">◉</span>
        <h3>Less noise</h3>
        <p>
          Precise subgraphs instead of exploratory file dumps. The
          agent sees signal, not your entire codebase crammed into
          a window.
        </p>
      </div>
      <div class="trio-card">
        <span class="trio-icon">◎</span>
        <h3>Fewer surprises</h3>
        <p>
          Know the blast radius before anything changes. No new
          dependents mid-implementation. No rework on code that
          was already working.
        </p>
      </div>
    </div>
  </section>

  <!-- VISUALIZATION -->
  <section class="human">
    <div class="section-label">The visualization</div>
    <h2 class="section-title">
      And while it's building,<br />you're not blind.
    </h2>

    <div class="human-intro">
      <p>
        Most agents work in the dark. You ask for a feature,
        something comes back, you review a diff and hope for the best.
      </p>
      <p>
        Serpentine's visualization updates in real time as your
        agent works. New functions appear as they're written.
        References form — or don't. The shape of the codebase
        changes in front of you.
      </p>
    </div>

    <div class="screenshot-frame">
      <div class="frame-bar">
        <div class="frame-dot"></div>
        <div class="frame-dot"></div>
        <div class="frame-dot"></div>
        <span class="frame-title">serpentine · localhost:8765</span>
      </div>
      <img
        src="/screenshot.png"
        alt="Serpentine visualization — interactive code reference graph"
      />
    </div>

    <p class="human-note">
      You don't have to read every file to know if you like what's
      being built. This part is for the developers who still want to
      know what's happening in their codebase. In 2026, that's not
      everyone. But if it's you, it's here.
    </p>
  </section>

  <!-- INIT -->
  <section class="init-section">
    <div class="section-label">Setup</div>
    <h2 class="section-title">One command to wire it in.</h2>
    <p class="section-sub" style="margin-top: 0.5rem">
      Installs skills, updates CLAUDE.md, and gets out of the way.
    </p>

    <div class="init-block">
      <div class="init-code">
        <pre><span class="c-dim">$</span> <span class="c-green">serpentine init</span>

<span class="c-dim">serpentine init complete (claude):</span>
<span class="c-dim">  ✓</span> <span class="c-white">.serpentine.yml created</span>
<span class="c-dim">  ✓</span> <span class="c-white">.gitignore updated</span>
<span class="c-dim">  ✓</span> <span class="c-blue">.claude/skills/code-analysis/SKILL.md installed</span>
<span class="c-dim">  ✓</span> <span class="c-white">CLAUDE.md updated</span></pre>
      </div>
      <div class="init-desc">
        <p>
          From that point on, your agent runs
          <code class="accent-code">stats</code>,
          <code class="accent-code">catalog</code>, and
          <code class="accent-code">analyze</code>
          before it reads files or writes a plan — not because you
          told it to this session, but because it's wired in.
        </p>
        <p>
          Auto-detects which harnesses are in use. Pass
          <code>--harness</code> to target one explicitly.
        </p>
        <div class="compat-tags">
          <span class="compat-tag">Claude Code</span>
          <span class="compat-tag">Cursor</span>
          <span class="compat-tag">Copilot</span>
          <span class="compat-tag">Codex</span>
          <span class="compat-tag">OpenCode</span>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section">
    <h2>Stop flying blind.<br />Orient first.</h2>
    <p>Free, open source, and works with the agents you already use.</p>

    <div class="cta-badges">
      <span class="badge"><span class="badge-dot"></span>Python · JS/TS · Rust</span>
      <span class="badge">Apache 2.0</span>
      <span class="badge">Built in Rust</span>
      <span class="badge">v0.2.0</span>
    </div>

    <div class="cta-btns">
      <a href="/docs/getting-started/installation" class="btn btn-primary">Get started →</a>
      <a href={GITHUB} class="btn btn-secondary" target="_blank" rel="noopener">View on GitHub</a>
    </div>
  </section>

</Base>

<style>
/* ─── Hero ─── */
.hero {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 120px 2rem 80px;
  position: relative;
  overflow: hidden;
}

.hero > *:not(canvas):not(.hero-bg):not(.hero-grid) {
  position: relative;
  z-index: 1;
}

.hero-bg {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse 130% 70% at 40% -10%,
      rgba(32,251,152,0.08) 0%,
      rgba(6,182,212,0.04) 50%,
      transparent 72%
    ),
    radial-gradient(ellipse 55% 45% at 92% 8%,
      rgba(196,255,94,0.05) 0%,
      rgba(32,251,152,0.02) 55%,
      transparent 75%
    );
  mask-image: linear-gradient(to bottom, black 45%, transparent 82%);
  -webkit-mask-image: linear-gradient(to bottom, black 45%, transparent 82%);
  pointer-events: none;
}

.hero-bg::after {
  content: '';
  position: absolute;
  inset: 0;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.72' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  background-repeat: repeat;
  background-size: 256px 256px;
  opacity: 0.045;
  mix-blend-mode: overlay;
}

.hero-grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(var(--border) 1px, transparent 1px),
    linear-gradient(90deg, var(--border) 1px, transparent 1px);
  background-size: 48px 48px;
  opacity: 0.3;
  mask-image: radial-gradient(ellipse 80% 60% at 50% 40%, black 20%, transparent 80%);
  pointer-events: none;
}

.hero-glass {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 2rem 2.5rem 1.75rem;
  max-width: 640px;
  width: 100%;
  background: rgba(13, 15, 14, 0.42);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(52, 211, 153, 0.1);
  border-radius: 16px;
  box-shadow:
    0 0 0 1px rgba(255,255,255,0.04) inset,
    0 4px 32px rgba(0,0,0,0.3);
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  background: var(--surface);
  border: 1px solid var(--border2);
  border-radius: 100px;
  padding: 0.3rem 0.85rem;
  font-size: 0.75rem;
  color: var(--text-muted);
  font-family: 'DM Mono', monospace;
  margin-bottom: 2rem;
  animation: fadeUp 0.5s ease both;
}

.hero-badge .dot {
  width: 6px;
  height: 6px;
  background: var(--accent);
  border-radius: 50%;
  animation: pulse 2s ease infinite;
}

.hero h1 {
  font-size: clamp(2rem, 5vw, 3.25rem);
  font-weight: 300;
  line-height: 1.1;
  letter-spacing: -0.03em;
  max-width: 800px;
  margin-bottom: 1.5rem;
  animation: fadeUp 0.5s 0.1s ease both;
}

.hero h1 em {
  font-style: normal;
  color: var(--accent);
}

.hero-sub {
  font-size: 1.05rem;
  color: var(--text-muted);
  max-width: 560px;
  line-height: 1.7;
  margin-bottom: 2.5rem;
  font-weight: 300;
  animation: fadeUp 0.5s 0.2s ease both;
}

.hero-install {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  background: var(--surface);
  border: 1px solid var(--border2);
  border-radius: 10px;
  padding: 0.75rem 1.25rem;
  font-family: 'DM Mono', monospace;
  font-size: 0.9rem;
  color: var(--text);
  margin-bottom: 1rem;
  animation: fadeUp 0.5s 0.3s ease both;
  cursor: pointer;
  transition: border-color 0.2s;
}

.hero-install:hover { border-color: var(--accent-dim); }

.hero-install .prompt { color: var(--accent); user-select: none; }

.hero-install .copy-hint {
  margin-left: auto;
  color: var(--text-dim);
  font-size: 0.7rem;
  font-family: 'DM Sans', sans-serif;
}

/* ─── Agent switcher ─── */
.agent-switcher {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0;
  margin-bottom: 1.75rem;
  animation: fadeUp 0.5s 0.35s ease both;
  width: 100%;
  max-width: 480px;
}

.agent-tabs {
  display: flex;
  width: 100%;
  border: 1px solid var(--border2);
  border-bottom: none;
  border-radius: 8px 8px 0 0;
  overflow: hidden;
}

.agent-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.3rem;
  background: var(--surface2);
  border: none;
  border-right: 1px solid var(--border);
  padding: 0.45rem 0.25rem;
  font-family: 'DM Mono', monospace;
  font-size: 0.65rem;
  color: var(--text-dim);
  cursor: pointer;
  transition: background 0.15s, color 0.15s;
  white-space: nowrap;
}

.tab-icon {
  width: 11px;
  height: 11px;
  flex-shrink: 0;
}

.agent-tab:last-child { border-right: none; }

.agent-tab:hover { background: var(--surface); color: var(--text-muted); }

.agent-tab.active {
  background: var(--surface);
  color: var(--accent);
  border-bottom: 1px solid var(--surface);
  margin-bottom: -1px;
  position: relative;
  z-index: 1;
}

.agent-command {
  width: 100%;
  background: var(--surface);
  border: 1px solid var(--border2);
  border-radius: 0 0 8px 8px;
  overflow: hidden;
}

.agent-command-body {
  padding: 0.7rem 0.85rem;
  font-family: 'DM Mono', monospace;
  font-size: 0.82rem;
  color: var(--text);
  display: flex;
  flex-direction: column;
  gap: 0.3rem;
}

.agent-command-body .line {
  display: flex;
  gap: 0.5rem;
  align-items: flex-start;
}

.agent-command-body .line .prompt { color: var(--accent); flex-shrink: 0; }

.agent-command-note {
  padding: 0.5rem 0.85rem 0.7rem;
  font-size: 0.75rem;
  color: var(--text-dim);
  font-family: 'DM Sans', sans-serif;
  font-weight: 300;
  border-top: 1px solid var(--border);
  line-height: 1.5;
}

.agent-command-note code {
  font-family: 'DM Mono', monospace;
  font-size: 0.75em;
  color: var(--text-muted);
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: 3px;
  padding: 0.1em 0.35em;
}

/* ─── Hero CTAs ─── */
.hero-ctas {
  display: flex;
  gap: 0.75rem;
  animation: fadeUp 0.5s 0.4s ease both;
}

/* ─── Problem ─── */
.problem {
  padding: 5rem 2rem;
  max-width: 680px;
  margin: 0 auto;
  text-align: center;
  border-top: 1px solid var(--border);
}

.problem p {
  font-size: 1.15rem;
  color: var(--text-muted);
  font-weight: 300;
  line-height: 1.8;
  margin-bottom: 1rem;
}

.problem p:last-child {
  color: var(--text);
  font-weight: 400;
}

.problem .highlight {
  color: var(--text);
  font-style: italic;
}

/* ─── How it works ─── */
.how {
  padding: 5rem 2rem;
  max-width: 900px;
  margin: 0 auto;
  border-top: 1px solid var(--border);
}

.steps {
  display: flex;
  flex-direction: column;
  gap: 1px;
  background: var(--border);
  border: 1px solid var(--border);
  border-radius: 12px;
  overflow: hidden;
}

.step {
  display: grid;
  grid-template-columns: 48px 1fr;
  background: var(--surface);
  transition: background 0.2s;
}

.step:hover { background: var(--surface2); }

.step-num {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding: 1.6rem 0 1.5rem;
  font-family: 'DM Mono', monospace;
  font-size: 0.7rem;
  color: var(--text-dim);
  border-right: 1px solid var(--border);
}

.step-content { padding: 1.25rem 1.5rem; }

.step-content h3 {
  font-size: 0.8rem;
  font-weight: 500;
  color: var(--text-muted);
  letter-spacing: 0.02em;
  margin-bottom: 0.5rem;
  text-transform: uppercase;
  font-family: 'DM Mono', monospace;
}

.step-desc {
  font-size: 0.875rem;
  color: var(--text-muted);
  font-weight: 300;
  line-height: 1.6;
}

.step-footer {
  padding: 1.25rem 1.5rem;
  background: var(--surface2);
  border-top: 1px solid var(--border);
  font-size: 0.875rem;
  color: var(--text-muted);
  font-style: italic;
  font-weight: 300;
}

/* ─── Trio ─── */
.trio {
  padding: 5rem 2rem;
  max-width: 900px;
  margin: 0 auto;
  border-top: 1px solid var(--border);
}

.trio-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1px;
  background: var(--border);
  border: 1px solid var(--border);
  border-radius: 12px;
  overflow: hidden;
  margin-top: 2.5rem;
}

.trio-card {
  background: var(--surface);
  padding: 2rem 1.75rem;
  position: relative;
  overflow: hidden;
  transition: background 0.2s;
}

.trio-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 2px;
  background: linear-gradient(90deg, var(--accent), transparent);
  opacity: 0;
