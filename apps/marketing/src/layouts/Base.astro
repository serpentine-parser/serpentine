---
import '../styles/global.css';

export interface Props {
  title?: string;
}
const { title = 'Serpentine — Richer context. Less noise. Fewer surprises.' } = Astro.props;

const GITHUB = 'https://github.com/serpentine-parser/serpentine';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
  </head>
  <body class="bg-bg text-text font-sans antialiased">

    <!-- Nav -->
    <nav id="main-nav" class="fixed top-0 inset-x-0 z-50 flex items-center justify-between px-6 h-14 bg-bg/85 backdrop-blur-md border-b border-border">
      <a href="/" class="flex items-center gap-2.5 no-underline text-text font-medium text-[0.95rem] tracking-[0.01em]">
        <img src="/logo.svg" alt="Serpentine" class="h-[22px] w-auto" />
        Serpentine
      </a>

      <!-- Desktop links -->
      <div id="nav-links" class="hidden md:flex items-center gap-1">
        <a href="/docs/getting-started/installation" class="text-text-muted no-underline text-sm px-3 py-1.5 rounded-md transition-colors hover:text-text hover:bg-surface-2">Docs</a>
        <a href="/blog" class="text-text-muted no-underline text-sm px-3 py-1.5 rounded-md transition-colors hover:text-text hover:bg-surface-2">Blog</a>
        <a href={GITHUB} target="_blank" rel="noopener"
           class="flex items-center gap-1.5 text-text-muted no-underline border border-border-2 px-3 py-1.5 rounded-md text-[0.8rem] transition-colors hover:text-text hover:bg-surface-2">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.167 6.839 9.49.5.09.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.163 22 16.418 22 12c0-5.523-4.477-10-10-10z" />
          </svg>
          GitHub
        </a>
      </div>

      <!-- Hamburger (mobile only) -->
      <button id="nav-hamburger" aria-label="Toggle navigation" aria-expanded="false"
              class="md:hidden flex flex-col justify-center gap-[5px] p-1.5 rounded-md bg-transparent border-none cursor-pointer transition-colors hover:bg-surface-2">
        <span class="block w-5 h-0.5 bg-text-muted rounded transition-transform duration-200 origin-center"></span>
        <span class="block w-5 h-0.5 bg-text-muted rounded transition-opacity duration-200"></span>
        <span class="block w-5 h-0.5 bg-text-muted rounded transition-transform duration-200 origin-center"></span>
      </button>
    </nav>

    <!-- Mobile nav drawer -->
    <div id="nav-drawer" class="hidden fixed top-14 inset-x-0 z-40 bg-bg/97 backdrop-blur-md border-b border-border px-4 py-3 flex-col gap-1 md:hidden">
      <a href="/docs/getting-started/installation" class="block text-text-muted no-underline text-[0.95rem] px-4 py-3 rounded-lg transition-colors hover:text-text hover:bg-surface-2">Docs</a>
      <a href="/blog" class="block text-text-muted no-underline text-[0.95rem] px-4 py-3 rounded-lg transition-colors hover:text-text hover:bg-surface-2">Blog</a>
      <a href={GITHUB} target="_blank" rel="noopener"
         class="flex items-center gap-2 text-text-muted no-underline text-[0.95rem] px-4 py-3 rounded-lg transition-colors hover:text-text hover:bg-surface-2">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.167 6.839 9.49.5.09.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.163 22 16.418 22 12c0-5.523-4.477-10-10-10z" />
        </svg>
        GitHub
      </a>
    </div>

    <slot />

    <!-- Footer -->
    <footer class="border-t border-border px-8 py-8 flex flex-col sm:flex-row items-center justify-between gap-6 max-w-content mx-auto">
      <div class="flex items-center gap-2 text-[0.85rem] text-text-dim">
        <img src="/logo.svg" alt="" class="h-4 brightness-0 invert opacity-30" />
        Serpentine
      </div>
      <div class="flex gap-6 justify-center flex-wrap">
        <a href="/docs/getting-started/installation" class="text-[0.8rem] text-text-dim no-underline hover:text-text-muted transition-colors">Docs</a>
        <a href="/blog" class="text-[0.8rem] text-text-dim no-underline hover:text-text-muted transition-colors">Blog</a>
        <a href={GITHUB} target="_blank" rel="noopener" class="text-[0.8rem] text-text-dim no-underline hover:text-text-muted transition-colors">GitHub</a>
        <a href={`${GITHUB}/blob/main/LICENSE`} target="_blank" rel="noopener" class="text-[0.8rem] text-text-dim no-underline hover:text-text-muted transition-colors">License</a>
      </div>
    </footer>

  </body>
</html>

<script>
  const hamburger = document.getElementById('nav-hamburger')!;
  const drawer    = document.getElementById('nav-drawer')!;
  const spans     = hamburger.querySelectorAll('span');

  function open()  {
    drawer.classList.remove('hidden');
    drawer.classList.add('flex');
    hamburger.setAttribute('aria-expanded', 'true');
    spans[0].style.transform = 'translateY(7px) rotate(45deg)';
    spans[1].style.opacity   = '0';
    spans[2].style.transform = 'translateY(-7px) rotate(-45deg)';
  }
  function close() {
    drawer.classList.add('hidden');
    drawer.classList.remove('flex');
    hamburger.setAttribute('aria-expanded', 'false');
    spans[0].style.transform = '';
    spans[1].style.opacity   = '';
    spans[2].style.transform = '';
  }

  hamburger.addEventListener('click', () =>
    drawer.classList.contains('hidden') ? open() : close()
  );
  drawer.querySelectorAll('a').forEach(a => a.addEventListener('click', close));
  document.addEventListener('keydown', e => e.key === 'Escape' && close());
</script>
